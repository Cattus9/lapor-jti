{
  "name": "lapor-jti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed-officers": "tsx scripts/db-seed-officers.ts",
    "db:studio": "drizzle-kit studio",
    "test:db-config": "tsx --test scripts/db-environment.test.ts",
    "test:auth-config": "tsx --test scripts/auth-environment.test.ts",
    "test:auth-smoke": "tsx scripts/auth-smoke.ts",
    "test:reports": "tsx --test scripts/report-domain.test.ts",
    "test:reports-smoke": "tsx scripts/report-smoke.ts",
    "test:satpam": "tsx --test scripts/satpam-domain.test.ts",
    "test:satpam-smoke": "tsx scripts/satpam-smoke.ts",
    "test:teknisi": "tsx --test scripts/technician-*.test.ts",
    "test:teknisi-smoke": "tsx scripts/technician-smoke.ts",
    "test:manajemen": "tsx --test scripts/management-*.test.ts",
    "test:manajemen-db": "node --conditions=react-server --import tsx scripts/management-db-smoke.ts",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build --watch",
    "docker:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
    "docker:prod": "docker compose --env-file .env.production -p aspirasijti-production -f compose.yaml up --build -d"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.45.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "postprocessing": "^6.39.5",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
