APP_PORT=3000
DB_PORT=5432
POSTGRES_DB=aspirasijti_dev
POSTGRES_USER=aspirasi_owner
POSTGRES_PASSWORD=local_owner_dev_only
APP_DB_USER=aspirasi_app
APP_DB_PASSWORD=local_app_dev_only

# Match the browser address (including APP_PORT). Keep localhost/127.0.0.1 consistent.
# [AUTH-SESSION] Konfigurasi engine Better Auth tetap dipakai saat provider Google ditambahkan.
# Kredensial OAuth Google Workspace nantinya terpisah dan hanya untuk server.
BETTER_AUTH_URL=http://localhost:3000
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Only for optional development seeding; never use this password in production.
# [AUTH-LOCAL] Password demo lokal, bukan password Google kampus atau kredensial production.
DEMO_USER_PASSWORD=AspirasiJTI-Dev-2026!

# Optional for Next.js running directly on the host. Docker uses its private storage volume.
REPORT_UPLOAD_DIR=storage/reports

# Containers use the internal host "db". The app's DATABASE_URL is assembled
# from PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD by src/db/environment.ts.
# For a database tool running on your laptop, optionally set:
# DATABASE_URL=postgresql://aspirasi_owner:local_owner_dev_only@127.0.0.1:5432/aspirasijti_dev
