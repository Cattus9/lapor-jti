# Production database credentials must not reuse development credentials.
APP_PORT=3000
POSTGRES_DB=aspirasijti_prod
POSTGRES_USER=aspirasi_owner
POSTGRES_PASSWORD=
APP_DB_USER=aspirasi_app
APP_DB_PASSWORD=

# Public HTTPS origin, without a path. Generate a distinct random auth secret.
# [AUTH-SESSION] Secret/origin aplikasi bukan kredensial OAuth Google Workspace; keduanya perlu dikonfigurasi terpisah.
BETTER_AUTH_URL=https://aspirasi.example.ac.id
BETTER_AUTH_SECRET=

# PostgreSQL is not published to a host port in production.
# Next.js binds to 127.0.0.1 on the host; put an HTTPS reverse proxy in front.
# SSO provider credentials will be added after the campus configuration is confirmed.
